{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reel-automator",
  "version": "0.1.0",
  "identifier": "com.reelautomator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**", "$DOWNLOAD/**", "$VIDEO/**", "$AUDIO/**", "/Volumes/**"]
      }
    },
    "windows": [
      {
        "title": "Reels EDL Automator",
        "width": 1280,
        "height": 840,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/whisperx-engine"],
    "resources": ["binaries/align_models"]
  }
}
